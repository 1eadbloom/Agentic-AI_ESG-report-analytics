# ESG Agent 環境變數設定
# cp .env.example .env 後填入對應值

# ── LLM（三選一）────────────────────────────────────────────────
# 方案 A：Ollama 本地模型（推薦，免費）
# 啟動 Ollama 後不需設定任何值，程式自動連 localhost:11434
ESG_MODEL=ollama/gemma3:4b

# 方案 B：課程 LiteLLM Proxy
# ESG_MODEL=gemini-2.5-flash
# LITELLM_API_KEY=your_key_here
# LITELLM_BASE_URL=https://your-endpoint/

# 方案 C：OpenAI
# ESG_MODEL=gpt-4o-mini
# LITELLM_API_KEY=sk-xxxx

# ── Embedding（不需修改，使用本地模型）──────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
