# ============================================================================
# ESG Agent 專案 .env（範本）
# 使用方式：複製成 .env，填入你自己的金鑰。
# 格式注意：= 兩側不要有空白、值不要加引號、註解單獨一行（不要寫在值的後面）。
# 所有程式都從「專案根目錄」讀取這個檔案，請在專案根目錄執行指令。
# ============================================================================


# ── 1. 主流程模型（Search／Interpretation／Solution 使用，走 Ollama）────────
# 預設模型；coordinator_agent.py 的 --model 參數會覆蓋它
ESG_MODEL=

# ── Embedding（不需修改，使用本地模型）──────────────────────────
EMBEDDING_MODEL=

# 是否開啟模型思考模式。預設 0（關閉）：關閉後單次呼叫約 5 秒，開啟約 100 秒，
# 且思考過程會用光 max_tokens 導致回應為空。要恢復思考時改成 1。
ESG_THINK=0
# 選用：取樣溫度。調低可減少亂碼字元與輸出忽有忽無的不穩定（建議 0.2）；不設定則使用模型預設值。
# ESG_TEMPERATURE=0.2

# 注意：不要設定 LITELLM_BASE_URL 與 LITELLM_API_KEY。
# 它們會套用到主流程的每一次呼叫，會把 gemma 的請求導向別的伺服器。
# Ollama 沒設定時預設使用 http://localhost:11434。
# LITELLM_BASE_URL=
# LITELLM_API_KEY=


# ── 2. Langfuse tracing（選用；沒有 LANGFUSE_PUBLIC_KEY 時所有追蹤都不啟用）──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 網址必須與你註冊專案的地區一致，否則會出現 401 Unauthorized。
# 歐盟：https://cloud.langfuse.com　美國：https://us.cloud.langfuse.com　日本：https://jp.cloud.langfuse.com
# 下面三個變數請填「同一個」地區網址（不含結尾斜線）：不同程式讀的變數名稱不同。
LANGFUSE_BASE_URL=
LANGFUSE_HOST=
LANGFUSE_OTEL_HOST=

# 讓根節點與 LLM 呼叫的環境標籤一致（否則一個是 default、一個是 production）
LANGFUSE_TRACING_ENVIRONMENT=development


# ── 3. KPI 除錯 ────────────────────────────────────────────────────────────
# 設成 1 時，每個面向都會印出 KPI 的處理結果；模型沒有輸出 KPI 時也會印出原始回應的結尾
ESG_DEBUG_KPI=0


# ── 4. KPI「LLM 檢查員」（選用；先用 evaluate_judge.py 量測，再決定要不要啟用）──
# 啟用後，流程會對每個 KPI 多呼叫一次檢查員模型，且要求它逐字引用原文。
# 注意顯存：檢查員模型與 gemma 不要同時載入，否則 Ollama 可能因 CUDA 初始化失敗而崩潰。
# 平常保持 0；只有 ESG_KPI_JUDGE=1 且設了 ESG_JUDGE_MODEL，流程才會使用檢查員。
ESG_KPI_JUDGE=0

# 檢查員模型（OpenAI 相容 API；evaluate_judge.py 也讀這三個變數，不需要把 ESG_KPI_JUDGE 設成 1）
ESG_JUDGE_MODEL=
ESG_JUDGE_BASE_URL=http://localhost:1235/v1
ESG_JUDGE_API_KEY=local

# 選用：檢查員回覆的最大 token 數（預設 1024）
# ESG_JUDGE_MAX_TOKENS=1024

# 選用：若回覆夾帶思考過程，依你的伺服器支援的方式關閉（參數名稱因伺服器而異，請先實測再用）
# ESG_JUDGE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}


# ── 5. 其他 ────────────────────────────────────────────────────────────────
# 選用：Hugging Face 權杖。沒設時終端機會有「unauthenticated requests to the HF Hub」的警告，不影響功能
# HF_TOKEN=
